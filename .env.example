PORT=3000
JWT_SECRET=change-this-to-a-long-random-secret

# Use Zapier first when this URL is set.
ZAPIER_CHAT_WEBHOOK_URL=

# Optional: use a published Zapier Chatbot URL as the embedded Haza AI panel.
ZAPIER_CHATBOT_URL=

# Optional direct AI fallback providers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CORS_ORIGIN=

# Production storage. Supabase is the primary database for portal data.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STATE_TABLE=micostskills_app_state
SUPABASE_BACKUP_TABLE=micostskills_app_backups
APP_STATE_ID=production

# Optional Firebase backup mirror. Use one of these credential styles.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
